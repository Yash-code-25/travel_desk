# Copy to the server's environment (or a .env file loaded by your process manager).
# Leave everything unset for local development.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=travel.yourcompany.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://travel.yourcompany.in
DJANGO_ADMIN_URL=choose-a-hard-to-guess-path/
DJANGO_DEMO_MODE=false
DJANGO_PORTAL_URL=https://travel.yourcompany.in

# Email (Office 365 example)
DJANGO_EMAIL_HOST=smtp.office365.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=traveldesk@yourcompany.in
DJANGO_EMAIL_PASSWORD=app-password-here
DJANGO_FROM_EMAIL=Travel Desk <traveldesk@yourcompany.in>
